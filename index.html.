<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Translucent Heart Model</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { margin: 0; overflow: hidden; background-color: #0a0a0a; font-family: sans-serif; }
        canvas { display: block; }
        #info-panel {
            position: absolute;
            top: 20px;
            left: 20px;
            pointer-events: none;
            color: white;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        }
        .label {
            position: absolute;
            color: white;
            background: rgba(0, 0, 0, 0.6);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            pointer-events: none;
            border: 1px solid rgba(255, 255, 255, 0.3);
            white-space: nowrap;
        }
    </style>
</head>
<body>

    <div id="info-panel" class="z-10">
        <h1 class="text-2xl font-bold text-red-500">Human Heart Study Model</h1>
        <p class="text-gray-400">Interactive 3D Translucent View</p>
        <div class="mt-4 space-y-1 text-sm">
            <p><span class="inline-block w-3 h-3 bg-red-600 rounded-full mr-2"></span>Left Side (Oxygenated)</p>
            <p><span class="inline-block w-3 h-3 bg-blue-600 rounded-full mr-2"></span>Right Side (Deoxygenated)</p>
            <p class="italic text-xs mt-4">Drag to rotate • Scroll to zoom</p>
        </div>
    </div>

    <div id="labels-container"></div>

    <script>
        let scene, camera, renderer, heartGroup;
        let isDragging = false;
        let previousMousePosition = { x: 0, y: 0 };
        const labels = [];

        function init() {
            // 1. Scene Setup
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x050505);

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 12;

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            document.body.appendChild(renderer.domElement);

            // 2. Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
            scene.add(ambientLight);

            const pointLight = new THREE.PointLight(0xffffff, 1);
            pointLight.position.set(10, 10, 10);
            scene.add(pointLight);

            const backLight = new THREE.PointLight(0xff4444, 0.5);
            backLight.position.set(-10, -5, -10);
            scene.add(backLight);

            // 3. Heart Group
            heartGroup = new THREE.Group();
            scene.add(heartGroup);

            createHeartAnatomy();

            // 4. Events
            window.addEventListener('resize', onWindowResize, false);
            document.addEventListener('mousedown', () => isDragging = true);
            document.addEventListener('mouseup', () => isDragging = false);
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('wheel', onMouseWheel);

            // Mobile Touch Events
            document.addEventListener('touchstart', (e) => {
                isDragging = true;
                previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
            });
            document.addEventListener('touchend', () => isDragging = false);
            document.addEventListener('touchmove', (e) => {
                if (!isDragging) return;
                const deltaX = e.touches[0].clientX - previousMousePosition.x;
                const deltaY = e.touches[0].clientY - previousMousePosition.y;
                heartGroup.rotation.y += deltaX * 0.01;
                heartGroup.rotation.x += deltaY * 0.01;
                previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
            });

            animate();
        }

        function createHeartAnatomy() {
            // Materials
            const muscleMat = new THREE.MeshPhongMaterial({
                color: 0xcc2222,
                transparent: true,
                opacity: 0.35,
                side: THREE.DoubleSide,
                shininess: 80
            });

            const internalMatRed = new THREE.MeshPhongMaterial({
                color: 0xff4444,
                transparent: true,
                opacity: 0.6
            });

            const internalMatBlue = new THREE.MeshPhongMaterial({
                color: 0x4444ff,
                transparent: true,
                opacity: 0.6
            });

            const vesselMatAorta = new THREE.MeshPhongMaterial({ color: 0xaa1111 });
            const vesselMatVena = new THREE.MeshPhongMaterial({ color: 0x2222aa });

            // --- MAIN BODY (Outer Shell) ---
            // Using a morphed sphere for the general heart shape
            const heartGeometry = new THREE.SphereGeometry(4, 32, 32);
            const positions = heartGeometry.attributes.position;
            for (let i = 0; i < positions.count; i++) {
                const x = positions.getX(i);
                const y = positions.getY(i);
                const z = positions.getZ(i);
                
                // Taper the bottom (apex)
                if (y < 0) {
                    const factor = 1 + (y / 6); 
                    positions.setX(i, x * factor);
                    positions.setZ(i, z * factor);
                }
                // Broaden the top
                if (y > 0) {
                    positions.setX(i, x * 1.1);
                }
            }
            const outerShell = new THREE.Mesh(heartGeometry, muscleMat);
            heartGroup.add(outerShell);

            // --- CHAMBERS (Internal Divisions) ---

            // Right Atrium
            addChamber(2, 2, 1.5, -1.5, 2, 1, internalMatBlue, "Right Atrium");
            
            // Right Ventricle
            addChamber(2.5, 3.5, 2, -1.5, -1.5, 1, internalMatBlue, "Right Ventricle");

            // Left Atrium
            addChamber(2, 2, 1.5, 1.5, 2, 0.5, internalMatRed, "Left Atrium");

            // Left Ventricle (Thicker/Larger)
            addChamber(2.8, 4, 2.5, 1.5, -1.5, 0.5, internalMatRed, "Left Ventricle");

            // Septum (Wall between ventricles)
            const septumGeo = new THREE.BoxGeometry(0.4, 5, 3);
            const septum = new THREE.Mesh(septumGeo, new THREE.MeshPhongMaterial({ color: 0x882222, transparent: true, opacity: 0.7 }));
            septum.position.set(0, -1, 0.5);
            septum.rotation.z = 0.1;
            heartGroup.add(septum);

            // --- GREAT VESSELS ---

            // Aorta (Arches from Left Ventricle)
            const aortaPath = new THREE.QuadraticBezierCurve3(
                new THREE.Vector3(1, 3, 0),
                new THREE.Vector3(0, 8, 0),
                new THREE.Vector3(-3, 4, -2)
            );
            const aortaGeo = new THREE.TubeGeometry(aortaPath, 20, 0.6, 8, false);
            const aorta = new THREE.Mesh(aortaGeo, vesselMatAorta);
            heartGroup.add(aorta);
            addLabel(new THREE.Vector3(-2, 7, -1), "Aorta");

            // Superior Vena Cava
            const svcGeo = new THREE.CylinderGeometry(0.5, 0.5, 4, 16);
            const svc = new THREE.Mesh(svcGeo, vesselMatVena);
            svc.position.set(-2, 5, 0.5);
            heartGroup.add(svc);
            addLabel(new THREE.Vector3(-2, 6, 0.5), "Superior Vena Cava");

            // Pulmonary Artery (T-shape)
            const paMainGeo = new THREE.CylinderGeometry(0.4, 0.4, 3, 16);
            const paMain = new THREE.Mesh(paMainGeo, vesselMatBlue);
            paMain.position.set(-0.5, 4.5, 1.5);
            paMain.rotation.z = Math.PI/4;
            heartGroup.add(paMain);
            addLabel(new THREE.Vector3(-0.5, 5, 1.5), "Pulmonary Artery");
        }

        function addChamber(w, h, d, x, y, z, mat, name) {
            const geo = new THREE.SphereGeometry(1, 24, 24);
            geo.scale(w/2, h/2, d/2);
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(x, y, z);
            heartGroup.add(mesh);
            
            addLabel(new THREE.Vector3(x, y, z), name);
        }

        function addLabel(vector, text) {
            const div = document.createElement('div');
            div.className = 'label';
            div.textContent = text;
            document.getElementById('labels-container').appendChild(div);
            labels.push({ element: div, position: vector });
        }

        function updateLabels() {
            labels.forEach(label => {
                const vector = label.position.clone();
                // Project 3D coordinate to heartGroup space, then to world, then to screen
                vector.applyMatrix4(heartGroup.matrixWorld);
                vector.project(camera);

                const x = (vector.x * .5 + .5) * window.innerWidth;
                const y = (vector.y * -.5 + .5) * window.innerHeight;

                // Only show if it's "in front" of the camera (z < 1)
                if (vector.z < 1) {
                    label.element.style.display = 'block';
                    label.element.style.left = `${x}px`;
                    label.element.style.top = `${y}px`;
                } else {
                    label.element.style.display = 'none';
                }
            });
        }

        function onMouseMove(event) {
            if (!isDragging) return;

            const deltaX = event.clientX - previousMousePosition.x;
            const deltaY = event.clientY - previousMousePosition.y;

            heartGroup.rotation.y += deltaX * 0.01;
            heartGroup.rotation.x += deltaY * 0.01;

            previousMousePosition = { x: event.clientX, y: event.clientY };
        }

        function onMouseWheel(event) {
            camera.position.z += event.deltaY * 0.01;
            camera.position.z = Math.max(5, Math.min(camera.position.z, 30));
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);
            
            // Subtle heart-beat pulse effect
            const pulse = 1 + Math.sin(Date.now() * 0.005) * 0.02;
            heartGroup.scale.set(pulse, pulse, pulse);

            // Auto-rotate slowly if not dragging
            if (!isDragging) {
                heartGroup.rotation.y += 0.002;
            }

            updateLabels();
            renderer.render(scene, camera);
        }

        window.onload = init;
    </script>
</body>
</html>

  
